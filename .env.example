# Copy to .env and fill in. The bridge logs in ONCE with these.
EUFY_EMAIL=
EUFY_PASSWORD=
EUFY_COUNTRY=GB

# Optional
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=3000
EUFY_SESSION=./data/.eufy-session.json
GO2RTC_CONFIG=./go2rtc.yaml
GO2RTC_ENABLE=1
# Ports the bundled go2rtc listens on (API, RTSP, WebRTC). Move them if another go2rtc holds them.
# GO2RTC_API_PORT=1984
# GO2RTC_RTSP_PORT=8554
# GO2RTC_WEBRTC_PORT=8555
BRIDGE_SELF_HOST=127.0.0.1
# EUFY_POLL_MS=600000

# Distinct per-install device identity. Leave unset for a single bridge (the SDK derives a stable one
# from your email). If you run MORE THAN ONE bridge on the same account, give each a UNIQUE value here —
# otherwise they share an identity and displace each other's session / split push (motion/person) delivery.
# BRIDGE_OPENUDID=

# Auto-off a camera's live stream after this many ms with no detection event (motion/person/…).
# Saves battery: the P2P live session (and the radio) stops when nothing is happening, even if HA
# still has the stream "open". The next detection lets it reopen. Default 300000 (5 min); 0 disables.
STREAM_IDLE_MS=300000

# Camera stills (/snapshot, what HA shows on a camera tile). auto (default): wake only MAINS cameras for
# a live still; a BATTERY camera shows its newest picture on disk (last event, or the last frame of a
# watched stream) and stays asleep, since HA re-fetches stills on a timer. 1 = live still for every
# camera, 0 = never. The pictures on disk are the fallback either way, so a failed live still no longer
# answers with an error.
# SNAPSHOT_LIVE=auto

# Continuous-stream budget for a BATTERY camera, in ms. The SDK stops a battery live session after this
# budget plus a 10s grace, so with the default (45000) a watched stream drops every ~55s and the reconnect
# wakes the camera again. Raise it to keep a watched stream up. Unset = SDK default. Mains cameras ignore it.
# STREAM_BATTERY_BUDGET_MS=180000

# Battery-saver: turn the device's native RTSP publish (rtspStream) OFF on a BATTERY camera left idle
# (no detection, no active bridge stream) this long. A forgotten rtspStream=ON on a battery cam encodes
# continuously and drains it. Default 300000 (5 min); 0 disables. Wired cameras are never touched.
RTSP_IDLE_OFF_MS=300000

# Verbose logging (opt-in). BRIDGE_DEBUG=1 logs each incoming WS command (HA polls, device.set, …),
# control-command timing, and P2P connect/close/ack — enough to trace the frontend↔SDK flow. Off by
# default. BRIDGE_DEBUG_P2P=1 additionally routes the SDK's raw per-frame transport logs (very noisy).
# BRIDGE_DEBUG=0
# BRIDGE_DEBUG_P2P=0
# Start every log line with the local time of day (zone from TZ); off by default, `docker logs -t` stamps too.
# LOG_TIMESTAMPS=1

# Event pre-warm (default OFF). When ON, the SDK speculatively opens a camera's P2P session on a
# high-intent event (doorbell / person / pet / package) so a following live view starts instantly —
# at the cost of holding a battery camera's radio open for ~28s per event. Set to 1 to enable.
# BRIDGE_PREWARM=0

# Event log (default ON). Prints a "[bridge:event]" line for each push/semantic event that arrives, how
# many frontend clients it reached, and each "Last event" image fetch and its result. Narrow and quiet
# (only fires on real events) — NOT the BRIDGE_DEBUG firehose. Set to 0 to silence.
# BRIDGE_EVENT_LOG=1
